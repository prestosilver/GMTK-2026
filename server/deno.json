{
  "workspace": ["./packages/db", "./packages/leaderboard"],
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-sys --env=.env main.ts",
    "db:generate": "deno task --filter @scope/db db:generate",
    "db:push": "deno task --filter @scope/db db:push"
  },
  "imports": {
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.1",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.5.1",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.9.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.9.0",
    "@prisma/client": "npm:@prisma/client@^7.9.0",
    "@std/assert": "jsr:@std/assert@1",
    "hono": "npm:hono@^4.12.31",
    "pg": "npm:pg@^8.22.0",
    "zod": "npm:zod@^4.4.3"
  }
}
